# 聊天协议：anthropic（/v1/messages，如 minimax /anthropic 端点）| openai（/chat/completions，市面主流）
# 不填则按 CHAT_BASE_URL 自动推断（含 /anthropic 走 anthropic，否则 openai）
# 也可在前端齿轮面板按供应商选择；保存后写入 data/provider-settings.json，优先于本文件并供网页/CLI 共用
CHAT_PROTOCOL=anthropic
# 聊天：Anthropic 兼容 /messages 格式（minimax /anthropic 端点）
CHAT_BASE_URL=https://api.minimaxi.com/anthropic
CHAT_API_KEY=your_anthropic_style_api_key_here
CHAT_MODEL=MiniMax-M3

# Embedding：OpenAI 兼容 /embeddings（ggniao 或其他）
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=your_api_key_here
OPENAI_COMPAT_EMBEDDING_MODEL=text-embedding-3-large
# 没有 Embedding Key 时会自动回退本地 Mock 跑通上传/检索（bigram hash，无需手动开启）。
# 切换到真模型后，请执行 npm run reindex:embeddings 用新模型重建索引——
# 否则向量空间错位（如 mock 256 维 × 真 3072 维）会被检索守卫拦截并明确报错。
# 仅当你想强制走 Mock（即便配了真 Key）时，才取消注释下一行：
# USE_MOCK_EMBEDDING=1

# Local data directory
DATA_DIR=./data

# 向量后端：local（默认，写 data/indexes）| supabase（读云端 match_chunks）
VECTOR_BACKEND=local

# Supabase（本地建库后 npm run sync:supabase 推上云；见 docs/supabase-setup.md）
# service_role 仅服务端 / CLI，切勿 NEXT_PUBLIC_ 或提交到 Git
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DOCUMENTS_BUCKET=documents
